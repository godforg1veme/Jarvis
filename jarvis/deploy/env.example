# Copy to deploy/.env on the server. Never commit the real file.
JARVIS_DOMAIN=jarvis.example.com
# Public HTTPS URL used for smoke checks and shown to Desktop users. This is an
# operational value; it is not read by the server process itself.
JARVIS_PUBLIC_URL=https://jarvis.example.com
JARVIS_LOG_LEVEL=info
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=
# URL-encode reserved characters in the password used here.
DATABASE_URL=postgresql://jarvis:encoded-password@postgres:5432/jarvis
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Start with echo, then switch to salad or openrouter. Fallback is optional.
JARVIS_MODEL_PROVIDER=echo
JARVIS_MODEL_FALLBACK_PROVIDER=
JARVIS_MODEL_TIMEOUT_MS=60000

# Managed Salad AI Gateway uses Bearer auth. A custom Container Gateway may use salad-api-key.
SALAD_BASE_URL=https://ai.salad.cloud/v1
SALAD_API_KEY=
SALAD_MODEL=
SALAD_AUTH_MODE=bearer

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional second OpenRouter account/key. Both values are required to enable it.
OPENROUTER_FALLBACK_API_KEY=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_REASONING_EXCLUDE=true

# Vision is opt-in. The dedicated key may be left empty to reuse OPENROUTER_API_KEY.
JARVIS_VISION_PROVIDER=disabled
JARVIS_VISION_BASE_URL=https://openrouter.ai/api/v1
JARVIS_VISION_API_KEY=
JARVIS_VISION_MODEL=
JARVIS_VISION_TIMEOUT_MS=60000
JARVIS_VISION_MEMORY_PATH=/srv/jarvis/vision
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JARVIS_VISION_MEMORY_KEY=
JARVIS_VISION_USER_QUOTA_BYTES=1073741824

# Optional final fallback. Do not reuse the local Desktop Agent key unless you
# explicitly want the same Google account to carry cloud fallback traffic.
GEMINI_API_KEY=
GEMINI_MODEL=

# Private knowledge base. Telegram Bot API downloads are limited to 20 MiB;
# PDF text uses pdftotext; audio/video metadata uses ffprobe. Speech remains
# untranscribed until server ASR is enabled.
JARVIS_DOCUMENT_STORAGE_PATH=/srv/jarvis/documents
JARVIS_DOCUMENT_MAX_BYTES=20971520
JARVIS_DOCUMENT_USER_QUOTA_BYTES=1073741824
JARVIS_DOCUMENT_WORKER_INTERVAL_MS=2000
JARVIS_PDFTOTEXT_BIN=pdftotext
JARVIS_FFPROBE_BIN=ffprobe
JARVIS_EMBEDDING_PROVIDER=disabled
JARVIS_EMBEDDING_BASE_URL=
JARVIS_EMBEDDING_API_KEY=
JARVIS_EMBEDDING_MODEL=
JARVIS_EMBEDDING_DIMENSIONS=0
JARVIS_EMBEDDING_TIMEOUT_MS=60000
JARVIS_EMBEDDING_BATCH_SIZE=32

# Desktop voice uses the private worker below. Telegram voice notes are opt-in,
# limited to 5 MiB/120 seconds/three per minute per allowed owner, and become a
# transcript rather than a stored document.
JARVIS_ASR_PROVIDER=disabled
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
JARVIS_ASR_TIMEOUT_MS=60000
JARVIS_TELEGRAM_VOICE_ENABLED=false

# Life OS can ingest deterministic events without model enrichment. Enable
# proactivity only after the Desktop Mission Control surface is deployed.
JARVIS_LIFE_OS_ENABLED=false
JARVIS_LIFE_OS_ENRICHMENT_ENABLED=false
JARVIS_LIFE_OS_PROACTIVITY_ENABLED=false
JARVIS_LIFE_OS_FIXTURE_SOURCES_ENABLED=false
JARVIS_LIFE_OS_WORKER_INTERVAL_MS=2000
# Retained only for the disabled Qwen benchmark profile.
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_MODEL_REVISION=7278e1e70fe206f11671096ffdd38061171dd6e5

# Operations panel remains disabled until the read-only Host Agent deployment
# and browser-session boundary have been verified.
JARVIS_OPERATIONS_ENABLED=false
JARVIS_OPERATIONS_HOST_KEY=vps
JARVIS_OPERATIONS_HOST_LABEL=Jarvis VPS
JARVIS_OPERATIONS_SOCKET_PATH=/run/jarvis-host-agent/agent.sock
JARVIS_OPERATIONS_AUTHENTICATOR_PATH=/run/secrets/operations_host_agent_authenticator
JARVIS_OPERATIONS_POLL_INTERVAL_MS=30000
JARVIS_OPERATIONS_OWNER_TELEGRAM_ID=0
JARVIS_OPERATIONS_PUBLIC_ORIGIN=https://jarvis.example.com
# Enables only the synthetic owner-approved no-op Telegram acceptance test.
# It never enables real VPN repair playbooks.
JARVIS_VPN_SUPERVISOR_ACCEPTANCE_ENABLED=false
