{
  "autoIndexOnFirstLaunch": true,
  "autoRefreshDays": 7,
  "scanRoots": [
    "C:\\Program Files",
    "C:\\Program Files (x86)",
    "%LOCALAPPDATA%\\Programs",
    "%APPDATA%",
    "%USERPROFILE%\\Desktop",
    "%PUBLIC%\\Desktop",
    "D:\\Programs",
    "D:\\Games",
    "D:\\Apps",
    "D:\\Projects"
  ],
  "maxDepth": 5,
  "maxFiles": 30000,
  "appRecovery": {
    "quickTimeoutMs": 5000,
    "extendedTimeoutMs": 120000,
    "quickMaxEntries": 3000,
    "maxEntries": 30000,
    "maxCandidates": 1000,
    "maxDepth": 8
  }
}
