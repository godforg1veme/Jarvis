{
  "name": "jarvis-family-server",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on Jarvis family assistant control plane",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "jobs:collect": "node src/jobs/collectorMain.js",
    "test:jobs:postgres": "node --test test/jobPostgresAcceptance.cjs test/jobCollectorAcceptance.cjs test/jobDraftAcceptance.cjs test/jobTelegramAcceptance.cjs test/jobApplicationsAcceptance.cjs test/jobDeliveryAcceptance.cjs",
    "test:jobs:e2e": "node --test test/jobE2eAcceptance.cjs",
    "test:jobs:runtime": "node --test test/jobFullRuntimeAcceptance.cjs",
    "test:jobs:browser": "node --test test/jobBrowserCollectorAcceptance.cjs",
    "test:jobs:browser:apply": "node --test test/jobBrowserApplicationsAcceptance.cjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.1",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}
