[Unit]
Description=Jarvis encrypted PostgreSQL and document backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/deploy/apps/jarvis
EnvironmentFile=/etc/jarvis/backup.env
ExecStart=/usr/bin/env bash /home/deploy/apps/jarvis/deploy/backup/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
